{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamCards",
  "version": "1.0.0",
  "identifier": "io.github.jhharry.steamcards",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Steam 卡牌估值",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 380,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "SteamCards",
    "shortDescription": "Steam 库存卡牌估值工具",
    "longDescription": "扫描 Steam 库存中的集换式卡牌，按社区市场最低挂单价估值并导出 CSV。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}