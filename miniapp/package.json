{
  "name": "steamcards-miniapp",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "SteamCards 小黑盒小程序：Steam 库存卡牌估值",
  "heybox": {
    "miniProgramId": "01a152a8-212d-7e63-aaaa-5cc084f6134d",
    "name": "Steam 卡牌估值",
    "desc": "读取 Steam 公开库存中的集换式卡牌，按社区市场参考价估算价值。",
    "category": "tool",
    "icon": "assets/icon.png",
    "coverImages": [
      "assets/cover.png"
    ],
    "platforms": [
      "android",
      "ios"
    ],
    "permissions": {
      "userInfo": {
        "enabled": true
      },
      "network": {
        "enabled": true,
        "useOfficialDomain": false
      },
      "storage": {
        "enabled": true
      }
    }
  },
  "scripts": {
    "hb-sdk": "hb-sdk",
    "dev": "hb-sdk dev",
    "build": "hb-sdk build",
    "deploy": "hb-sdk remote deploy"
  },
  "dependencies": {
    "@heybox/hb-sdk": "^0.9.1"
  },
  "devDependencies": {
    "vite": "^8.0.12"
  }
}
